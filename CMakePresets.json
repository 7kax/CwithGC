{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "strict",
      "displayName": "Strict warning build",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/strict",
      "cacheVariables": {
        "GC_ENABLE_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "displayName": "ASan and UBSan build",
      "inherits": "strict",
      "binaryDir": "${sourceDir}/build/sanitizers",
      "cacheVariables": {
        "GC_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "library",
      "displayName": "Library-only release build",
      "inherits": "strict",
      "binaryDir": "${sourceDir}/build/library-preset",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "GC_ENABLE_DEBUG_API": "OFF",
        "GC_ENABLE_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "strict",
      "configurePreset": "strict"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "library",
      "configurePreset": "library"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "strict",
      "configurePreset": "strict",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
